# ── Database ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.
DATABASE_URL=postgresql+asyncpg://mininetflix:mininetflix@localhost:5432/mininetflix

# ── App behaviour ────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO

# ── Resilience / fault-injection (local experiments only) ────────────────────
# Set to "true" to enable the ?simulate_delay and ?simulate_failure query params.
# Must remain "false" (or unset) in any public/production deployment.
ENABLE_FAULT_INJECTION=false

# ── Recommendation fallback ───────────────────────────────────────────────────
# Milliseconds before the recommendation dependency is considered too slow.
RECOMMENDATION_TIMEOUT_MS=500
